# Polling and state
CHP_ALERT_INTERVAL=30
CHP_ALERT_TIMEOUT=20
CHP_ALERT_STATE_FILE=runtime/state.json
CHP_ALERT_DETAIL_LOG_FILE=runtime/details.jsonl
CHP_ALERT_RETENTION_HOURS=72
CHP_ALERT_LOG_LEVEL=INFO

# Service-area GeoJSON. Relative paths resolve from the repository/application folder.
CHP_ALERT_SERVICE_AREA_FILE=service_area.geojson

# MARK monitoring profile. The GUI manages these values and can save named profiles.
CHP_ALERT_PROFILE=
# First-pass AREA allowlist. MARK compares only the first two characters.
# Known AREA values: San Diego, Temecula, Oceanside, El Cajon, BC.
# Station 36 defaults to Border Communications and El Cajon.
CHP_ALERT_AREA_PREFIXES=BC,El
# Case-insensitive substrings searched in the CHP Type column before details are fetched.
CHP_ALERT_TYPE_FRAGMENTS=Unk,1140,1141,Min,Maj,1179,1180,1178,un w,Repo

# Legacy profile keys retained for migration compatibility; the fast filters above are authoritative.
CHP_ALERT_IGNORED_AREAS=Oceanside,Temecula
CHP_ALERT_INCIDENT_TYPES=Trfc Collision-1141Enrt,Trfc Collision-Unkn Inj,Report of Fire

# Nominatim is fallback-only when detail-header coordinates are unavailable.
CHP_ALERT_GEOCODER=nominatim
CHP_ALERT_CONTACT=mailto:you@example.com

# First startup primes existing incidents without alerting by default.
# Detail changes are always logged. Set updates to 1 only to re-page relevant calls.
CHP_ALERT_EXISTING=0
CHP_ALERT_UPDATES=0

# Pushover emergency alert profile.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_PRIORITY=2
PUSHOVER_RETRY_SECONDS=30
PUSHOVER_EXPIRE_SECONDS=1800
# Long built-in choices: alien, climb, echo, updown, persistent.
PUSHOVER_SOUND=alien
